# Copy to .env and fill in. Never commit .env.
# Required: generate with: openssl rand -hex 32
API_TOKEN=<redacted>

# Optional: shared secret for webhook HMAC (X-Cryptopay-Signature). If
# unset, webhooks are sent unsigned (local testing only).
WEBHOOK_SECRET=<redacted>

# Port the service listens on. Default 18777, deliberately uncommon:
# 8080 is already taken on many hosts (web servers, and cryptoPriceAPI
# itself defaults to 8080), so cryptopay does not fight for it.
# If you change PORT here, change the host port in docker-compose.yml
# to match (the HEALTHCHECK uses the container port).
PORT=18777
# Bind address. 0.0.0.0 for Docker; 127.0.0.1 when running bare locally.
BIND=0.0.0.0
# Where invoices.json and pool.json live.
DATA_DIR=/data
# Public base URL for pay links in API responses (optional; without it,
# pay_url is a relative path like /pay/<id>).
PUBLIC_URL=

# Price source for amount_usd invoices. Two options, both keyless:
# 1. Your own cryptoPriceAPI (recommended): it aggregates 6 exchanges
#    into one VWAP price, with outlier filtering, and needs no key.
#    Start it on its own port (it also defaults to 8080, so pick
#    another one on a host where 8080 is taken), then point here:
#    PRICE_API_URL=http://127.0.0.1:19080
#    Note: the first amount_usd invoice for a coin can take up to
#    ~5 seconds while cryptoPriceAPI subscribes to that symbol; later
#    invoices for the same coin are fast. ARB/OP/BASE are priced as
#    ETH, because they pay in ETH on their L2, not in ARB/OP tokens.
# 2. Leave PRICE_API_URL empty: cryptopay falls back to CoinPaprika
#    (keyless, https://api.coinpaprika.com/v1/tickers/<id>), which
#    covers every coin here, including XMR.
PRICE_API_URL=
# Only needed if you self-host a CoinPaprika-compatible price API.
PRICE_API_BASE_URL=https://api.coinpaprika.com

# Invoice lifetime in minutes (default 60). Partial payments get a 24h
# grace after expiry before becoming underpaid; expired invoices keep
# polling for late payments for 7 days.
INVOICE_EXPIRY_MIN=60
# How often the watch loop polls pool addresses, in seconds (default 30).
# Polling is bounded-parallel (8 workers), so one slow chain API does
# not stall the others, but raising this still helps if you run many
# open invoices against rate-limited public APIs.
POLL_INTERVAL_SEC=10

# Per-coin balance/tx APIs. Defaults are keyless public endpoints; there
# are no API-key variables any more, on purpose. Override a URL only to
# point at a self-hosted explorer (e.g. your own Blockscout) if the
# public instance challenges your IP (some Blockscout instances sit
# behind Cloudflare and challenge datacenter IPs).
BTC_ESPLORA_URL=https://blockstream.info/api
LTC_ESPLORA_URL=https://litecoinspace.org/api
ETH_API_URL=https://eth.blockscout.com/api
MATIC_API_URL=https://polygon.blockscout.com/api
ARB_API_URL=https://arbitrum.blockscout.com/api
OP_API_URL=https://optimism.blockscout.com/api
BASE_API_URL=https://base.blockscout.com/api
AVAX_API_URL=https://api.routescan.io/v2/network/mainnet/evm/43114/etherscan/api
DOGE_BLOCKBOOK_URL=https://blockbook.doge.zelcore.io
BCH_BLOCKBOOK_URL=https://blockbook.bch.zelcore.io
DASH_BLOCKBOOK_URL=https://blockbook.dash.zelcore.io
ZEC_BLOCKBOOK_URL=https://blockbook.zec.zelcore.io
ADA_ADASTAT_URL=https://api.adastat.net/rest/v1
ADA_KOIOS_URL=https://api.koios.rest/api/v1
XRP_RPC_URL=https://xrplcluster.com
XLM_HORIZON_URL=https://horizon.stellar.org
TRON_API_URL=https://api.trongrid.io
SOL_RPC_URL=https://api.mainnet-beta.solana.com
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Monero: a view-only monero-wallet-rpc, run as its own service in
# the same compose stack (docker-compose.monero.yml), or reachable
# privately if you run it elsewhere. See README "Monero setup".
# Run ./scripts/setup-monero.sh (guided, skippable) to generate the
# view-only wallet, pick nodes, and start that service. When the
# service is used, cryptopay reaches it by service name inside
# Docker, and host tools use the localhost port (the service
# publishes 18088 only on 127.0.0.1). No RPC login in the compose
# service: it is reachable only from this host and the compose
# network. If you run an RPC elsewhere with --rpc-login, set the
# user and password here instead.
XMR_WALLET_RPC_URL=http://monero-wallet-rpc:18088/json_rpc
XMR_WALLET_RPC_USER=
XMR_WALLET_RPC_PASS=
# First daemon for the RPC service (from your node list, first good
# node at setup time). The watchdog switches it later if needed.
XMR_DAEMON=

# Optional XMR daemon failover, via scripts/xmr-node-watch.sh (run it
# from cron every 5 minutes). It asks the wallet RPC to switch daemons
# (set_daemon, trusted=false) when the current daemon is down or more
# than XMR_NODE_MAX_LAG blocks behind the best node in your list.
# This list is operator-curated, not fetched at runtime: pick nodes
# yourself from monero.fail, verify them, and replace the examples.
# setup-monero.sh asks for 1 to 10 nodes and tests each one.
# Leave XMR_NODE_LIST empty to disable the watchdog entirely.
# XMR_NODE_LIST="nodes.hashvault.pro:18081 node.monerodevs.org:18089"
# XMR_NODE_MAX_LAG=10
# XMR_NODE_STATE=./xmr-node.state
# Only if your nodes are .onion nodes:
# XMR_DAEMON_PROXY=127.0.0.1:9050

# Required confirmations per coin (defaults: BTC 2, LTC 6, ETH 12,
# MATIC 64, ARB 12, OP 12, BASE 12, AVAX 12, DOGE 6, BCH 6, DASH 6,
# ZEC 12, ADA 15, XRP 1, XLM 1, TRX 20, SOL 32, USDC 32, USDT 32, XMR 10).
CONF_BTC=2
CONF_LTC=6
CONF_ETH=12
CONF_MATIC=64
CONF_ARB=12
CONF_OP=12
CONF_BASE=12
CONF_AVAX=12
CONF_DOGE=6
CONF_BCH=6
CONF_DASH=6
CONF_ZEC=12
CONF_ADA=15
CONF_XRP=1
CONF_XLM=1
CONF_TRX=20
CONF_SOL=32
CONF_USDC=32
CONF_USDT=32
CONF_XMR=10
